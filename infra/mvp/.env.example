# Copy this file to infra/mvp/.env and replace every change-me/replace-me value.
CONTROL_CENTER_BIND_ADDRESS=0.0.0.0
CONTROL_CENTER_PORT=8080
DB_URL=jdbc:postgresql://postgres:5432/audiobook_factory
DB_USERNAME=audiobook
DB_PASSWORD=change-me
STORAGE_ROOT=/data
WORKER_ENROLL_TOKEN=replace-me-with-a-long-random-worker-enrollment-token
APP_ACCESS_TOKEN=replace-me-with-a-long-random-control-center-token
# 服务器无法直连外网时，仅用于 Docker 构建阶段下载依赖；不要把代理端口暴露到公网。
MVP_HTTP_PROXY=
MVP_HTTPS_PROXY=
MVP_NO_PROXY=localhost,127.0.0.1,::1
MVP_MAVEN_OPTS=
AUDIOBOOKSHELF_ENABLED=false
AUDIOBOOKSHELF_BASE_URL=http://audiobookshelf:80
AUDIOBOOKSHELF_LIBRARY_ID=replace-me-with-the-audiobookshelf-library-id
AUDIOBOOKSHELF_API_KEY=replace-me-with-the-audiobookshelf-api-key
